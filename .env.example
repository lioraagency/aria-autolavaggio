# =============================================================================
# ARIA Autolavaggio — environment template (LIORA)
# Copy to .env.local for local development. Never commit real values.
# =============================================================================

# Session cookie encryption for iron-session (min 32 chars). Required for real deployments.
AUTH_SECRET=

# Server-side display name / business label.
CLIENT_NAME=

# Public client name (exposed in browser bundle via NEXT_PUBLIC_*).
NEXT_PUBLIC_CLIENT_NAME=

# Site base URL for absolute URLs and callbacks (no trailing slash recommended).
NEXT_PUBLIC_SITE_URL=

# Cal.com server API key for staff booking fetch (never expose as NEXT_PUBLIC_*).
CAL_API_KEY=

# Supabase project URL (public with RLS; still treat as config secret in ops).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key for browser with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only; bypasses RLS; never ship to client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (or compatible) API key for transactional email.
RESEND_API_KEY=

# Twilio account identifier for SMS.
TWILIO_ACCOUNT_SID=

# Twilio auth token for SMS API.
TWILIO_AUTH_TOKEN=

# Twilio sender number in E.164 or provider-supported format.
TWILIO_PHONE_NUMBER=

# Email address for owner/staff operational notifications.
OWNER_NOTIFICATION_EMAIL=

# Phone number for critical SMS alerts to owner/operator.
OWNER_NOTIFICATION_PHONE=
